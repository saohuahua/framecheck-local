{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Framecheck Local",
  "version": "0.0.0",
  "identifier": "com.framecheck.local",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:5173 ws://127.0.0.1:5173; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Framecheck Local",
        "width": 1440,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false
  }
}

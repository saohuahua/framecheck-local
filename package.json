{
  "name": "framecheck-local",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:fixtures": "node tests/scripts/run-real-fixtures.mjs",
    "test:psd-poc": "node tests/scripts/run-v4-psd-poc.mjs",
    "analyze": "vue-tsc -b && vite build --mode analyze"
  },
  "dependencies": {
    "@zip.js/zip.js": "^2.15.0",
    "dexie": "^4.4.6",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.9.10",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "ag-psd": "^31.0.2",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
